# ==========================================
# MoneyMate — เพื่อนช่วยจัดการเงิน (.env.example)
# ห้ามนำ Secret Key จริงใส่ลงในไฟล์นี้หรือ Commit ขึ้น Git
# ==========================================

# 1. Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. Google Gemini API Configuration (Server-Side Only)
# แนะนำโมเดลปัจจุบัน: gemini-3.8-flash (แทนที่รุ่น legacy gemini-2.5-*)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# 3. PromptPay Payment Gateway Configuration
# ค่าที่รองรับ: sandbox | gbprimepay | opn
PAYMENT_PROVIDER=sandbox
PAYMENT_PUBLIC_KEY=your-payment-gateway-public-key
PAYMENT_SECRET_KEY=your-payment-gateway-secret-key
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-signing-secret

# 4. Application & Security Configuration
APP_URL=http://localhost:3000
TRIAL_SESSION_SECRET=change-this-to-a-32-byte-random-hex-secret-in-production
